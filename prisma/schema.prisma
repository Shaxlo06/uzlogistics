generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Company {
  id          String   @id @default(cuid())
  name        String
  legalName   String?
  slug        String   @unique
  region      String
  district    String?
  address     String?
  phonePrefix String?
  phoneFull   String?
  description String?
  website     String?
  telegram    String?
  instagram   String?
  facebook    String?
  latitude    Float?
  longitude   Float?
  yearsOnSite Int?
  likesCount  Int      @default(0)
  workMode    String?
  isProducer  Boolean  @default(false)
  isExporter  Boolean  @default(false)
  sourceUrl   String?
  sourceId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services  CompanyService[]
  metrics   RealtimeMetric[]
  shipments Shipment[]

  @@index([region])
}

model Service {
  id        String   @id @default(cuid())
  name      String   @unique
  nameRu    String?
  nameEn    String?
  companies CompanyService[]
}

model CompanyService {
  companyId String
  serviceId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([companyId, serviceId])
}

model Shipment {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  originRegion String
  destRegion   String
  cargoType    String
  status       String
  progressPct  Int      @default(0)
  etaHours     Int?
  currentLat   Float?
  currentLng   Float?
  costUsd      Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RealtimeMetric {
  id         String   @id @default(cuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  metricType String
  value      Float
  unit       String
  recordedAt DateTime @default(now())
}

model ForecastPoint {
  id              String @id @default(cuid())
  year            Int
  metricType      String
  historicalValue Float?
  forecastValue   Float?
  lowerBound      Float?
  upperBound      Float?
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
